<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Supertext.Umbraco.Translation</RootNamespace>
    <PackageId>Supertext.Umbraco.Translation</PackageId>
    <Version>0.1.0</Version>
    <Title>Supertext Translation for Umbraco</Title>
    <Description>Translate Umbraco documents into other languages with Supertext AI, from a "Translate with Supertext" action in the backoffice.</Description>
    <Authors>Supertext AG</Authors>
    <PackageTags>umbraco;umbraco-marketplace;translation;supertext</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Supertext/Umbraco-Supertext-Translation</RepositoryUrl>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.8.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.8.0, 19.0.0)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Supertext SDK, bundled (namespace Supertext.Umbraco.Translation.Sdk): see lib/supertext-sdk/README.md -->
    <Compile Include="../../lib/supertext-sdk/src/**/*.cs" Link="Sdk/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Supertext Plugin Health, bundled (namespace Supertext.Umbraco.Translation.PluginHealth): see lib/supertext-plugin-health/README.md -->
    <Compile Include="../../lib/supertext-plugin-health/src/**/*.cs" Link="PluginHealth/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Supertext.Umbraco.Translation.Tests" />
  </ItemGroup>
</Project>
